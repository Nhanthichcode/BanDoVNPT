<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'Trang chủ' %> - Hệ thống giám sát VNPT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="icon" type="image/png" href="/images/Mini%20logo.png">

    <style>
        /* 1. Bố cục trang tổng thể */
        body { background-color: #f8f9fa; display: flex; flex-direction: column; min-height: 100vh; margin: 0; }
        .bg-vnpt { background-color: #0072BC !important; }
        
        /* 2. Thống kê Card */
        .stat-card { border: none; border-radius: 10px; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); transition: transform 0.2s;}
        .stat-card:hover { transform: translateY(-3px); }
        .icon-box { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        
        /* 3. Hiệu ứng chớp nháy (ĐÃ SỬA LỖI BỎ SCALE ĐỂ KHÔNG BỊ LƠ LỬNG) */
        @keyframes pulse-danger {
            0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.8); }
            70% { box-shadow: 0 0 0 15px rgba(220, 53, 69, 0); }
            100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
        }
        .marker-danger-icon {
            background-color: #dc3545; color: white; border-radius: 50%; border: 2px solid white;
            display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 14px;
            animation: pulse-danger 1.5s infinite;
        }

        /* 4. Dropdown Menu & Bản đồ */
        .dropdown-menu-list { max-height: 300px; overflow-y: auto; width: 320px; }
        .dropdown-menu-list::-webkit-scrollbar { width: 6px; }
        .dropdown-menu-list::-webkit-scrollbar-thumb { background-color: #ccc; border-radius: 10px; }
        .leaflet-container { z-index: 1 !important; }

        /* 5. Container giới hạn chiều cao bảng */
        .table-container-scroll {
            max-height: 65vh; /* Dùng vh thay vì dvh để tương thích nhiều trình duyệt hơn */
            overflow-y: auto;
            border: 1px solid #dee2e6; 
            position: relative;
        }
        .table-container-scroll thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa; 
            z-index: 2;
            border-bottom: 2px solid #dee2e6;
        }

        /* 6. Sidebar và Footer */
        .sidebar {
            position: sticky;
            top: 0;              
            overflow-y: auto;
            z-index: 1000;
        }
        .footer-thin {
            padding: 0.5rem 0; 
            font-size: 0.75rem; 
            border-top: 1px solid rgba(255,255,255,0.1);
        }

         #map-picker { 
            height: 500px; 
            width: 100%; 
            border-radius: 0 0 15px 15px;
        }
        .leaflet-container { z-index: 1 !important; }
    </style>

    <%- typeof stylesheet !== 'undefined' ? stylesheet : '' %>
</head>
<body>
    <%- include('../partials/banner.ejs') %>
    <%- include('../partials/navbar.ejs') %>

    <div class="container-fluid flex-grow-1">
        <div class="row h-100">
            <%- include('../partials/sidebar.ejs') %>

            <%- body %>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <%- include('../partials/modal_fade.ejs') %>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // 1. Khai báo biến toàn cục
    const userVaiTroId = <%= user ? user.vai_tro_id : 'null' %>;
    console.log("Vai trò người dùng (userVaiTroId):", userVaiTroId);
    window.appMap = null;
    window.appMarkers = {};
    window.appSplitterMarkers = {};

    // Biến cho modal picker
    let pickerMap;
    let tempMarker;
    let isEditingMap = false;
    let currentScale = parseFloat(localStorage.getItem('interfaceScale')) || 0.8;

                    const mangGoiCuoc = <%- JSON.stringify(typeof danhSachGoiCuoc !== 'undefined' ? danhSachGoiCuoc : []) %>;

                    function capNhatGoiCuoc() {
                        const loaiHinh = document.getElementById('chon_loai_hinh').value;
                        const selectGoiCuoc = document.getElementById('chon_goi_cuoc');
                        selectGoiCuoc.innerHTML = '<option value="">-- Chọn gói cước --</option>';

                        if (!loaiHinh) return;
                        const danhSachLoc = mangGoiCuoc.filter(gc => gc.loai_hinh_thue_bao && gc.loai_hinh_thue_bao.includes(loaiHinh));

                        danhSachLoc.forEach(gc => {
                            const option = document.createElement('option');
                            option.value = gc.id;
                            option.textContent = gc.ten_goi_cuoc;
                            selectGoiCuoc.appendChild(option);
                        });
                    }
                

    // ==========================================
    // HÀM ÁP DỤNG SCALE GIAO DIỆN
    // ==========================================
    function applyScale() {
        const mainContent = document.querySelector('main');
        if (!mainContent) return;

        mainContent.style.zoom = currentScale;
        
        const scaleDisplay = document.getElementById('scale-level');
        if (scaleDisplay) {
            scaleDisplay.innerText = Math.round(currentScale * 100) + '%';
        }

        // Ép bản đồ vẽ lại sau khi zoom
        if (window.appMap) {
            setTimeout(() => {
                window.appMap.invalidateSize();
            }, 300);
        }
    }

    function scaleContent(action) {
        if (action === 'in' && currentScale < 1.5) {
            currentScale += 0.1;
        } else if (action === 'out' && currentScale > 0.5) {
            currentScale -= 0.1;
        } else if (action === 'reset') {
            currentScale = 0.8;
        }

        currentScale = Math.round(currentScale * 10) / 10;
        localStorage.setItem('interfaceScale', currentScale);
        applyScale();
    }

    // ==========================================
    // HÀM DÙNG CHUNG CHO BẢN ĐỒ
    // ==========================================
    function performFlyTo(markerObj) {
        if (!window.appMap) return;
        window.appMap.closePopup();
        document.getElementById('map-dashboard').scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
            window.appMap.flyTo(markerObj.getLatLng(), 18, { animate: true, duration: 2.0 });
            window.appMap.once('moveend', () => markerObj.openPopup());
        }, 400);
    }

    function zoomToMap(id) {
        const searchId = String(id).toLowerCase().trim();
    let marker = null;

    // Ưu tiên tìm Khách Hàng trước
    if (window.appMarkers && window.appMarkers[searchId]) {
        marker = window.appMarkers[searchId];
    } 
    // Nếu không thấy, tìm tiếp trong Tủ Cáp
    else if (window.appSplitterMarkers && window.appSplitterMarkers[searchId]) {
        marker = window.appSplitterMarkers[searchId];
    }

    if (marker) {
        performFlyTo(marker);
    } else {
        alert("Lỗi: Không tìm thấy tọa độ điểm này trên bản đồ.");
    }
    }

    function zoomToSplitter(id) {
        console.log("Tìm marker tủ cáp với ID:", id);
        const marker = window.appSplitterMarkers[String(id).toLowerCase().trim()];
        console.log("Marker tủ cáp tìm được cho ID", id, ":", marker);
        if (marker) performFlyTo(marker);
    }

    // ==========================================
    // HÀM CHO MODAL CHỌN VỊ TRÍ (PICKER)
    // ==========================================
    function updateMarker(lat, lng) {
        if (tempMarker) pickerMap.removeLayer(tempMarker);
        tempMarker = L.marker([lat, lng], { draggable: true }).addTo(pickerMap);
        
        document.getElementById('display-lat').innerText = lat.toFixed(6);
        document.getElementById('display-lng').innerText = lng.toFixed(6);

        tempMarker.on('dragend', function(event) {
            const pos = event.target.getLatLng();
            updateMarker(pos.lat, pos.lng);
        });
    }
    let currentModal = '', input_vi_do='', input_kinh_do='';

function SetDataModal(name, inputViDoId, inputKinhDoId) {
    // 1. Lưu ID vào biến toàn cục để hàm xacNhanToaDo() biết chỗ điền dữ liệu về sau
    currentModal = name;
    input_vi_do = inputViDoId;
    input_kinh_do = inputKinhDoId;

    // 2. Lấy giá trị tọa độ hiện có từ các input của form (nếu có - chế độ Sửa)
    const lat = document.getElementById(inputViDoId)?.value;
    const lng = document.getElementById(inputKinhDoId)?.value;

    // 3. Nếu đã có tọa độ hợp lệ, chuẩn bị sẵn trạng thái cho bản đồ trong Modal
    if (lat && lng && parseFloat(lat) !== 0) {
        capNhatToaDoModal(lat, lng);
    } else {
        // Nếu là thêm mới (tọa độ trống/0), xóa marker cũ để tránh nhầm lẫn[cite: 6]
        capNhatToaDoModal(0, 0);
    }
}

function xacNhanToaDo() {  
    const lat = document.getElementById('display-lat').innerText;
    const lng = document.getElementById('display-lng').innerText;
    if (lat === "0") return alert("Vui lòng click chọn một điểm trên bản đồ!");
    
    // Điền tọa độ vào form (nếu có)
    const inputViDo = document.getElementById(input_vi_do);
    const inputKinhDo = document.getElementById(input_kinh_do);
    if (inputViDo && inputKinhDo) {
        inputViDo.value = lat;
        inputKinhDo.value = lng;
    }

    // Đóng modal picker an toàn
    const mapModalEl = document.getElementById('modalPickLocation');
    const mapModal = bootstrap.Modal.getInstance(mapModalEl);
    if (mapModal) {
        mapModal.hide();
    }

    // Đợi picker ẩn hoàn toàn rồi mở modal nguồn
    setTimeout(() => {
        if (!currentModal) {
            console.warn('Chưa set modal nguồn (currentModal rỗng)');
            return;
        }
        const formModalEl = document.getElementById(currentModal);
        if (!formModalEl) {
            console.error('Không tìm thấy modal:', currentModal);
            return;
        }
        let formModal = bootstrap.Modal.getInstance(formModalEl);
        if (!formModal) {
            formModal = new bootstrap.Modal(formModalEl);
        }
        formModal.show();
    }, 400);
}

    // ==========================================
    // HÀM SỬA SPLITTER
    // ==========================================
    function chuanBiSuaSplitter(id, ten, sys, loai, chaId, lat, lng) {
        document.getElementById('formSuaSplitter').action = '/splitter/sua/' + id;
        document.getElementById('sua_ten_splitter').value = ten;
        document.getElementById('sua_sys_id').value = sys;
        document.getElementById('sua_loai_splitter_sua').value = loai;
        document.getElementById('vi_do_tu_pon_sua').value = lat;
        document.getElementById('kinh_do_tu_pon_sua').value = lng;
        document.getElementById('sua_splitter_cha_id').value = chaId? chaId : '';    
        
        const khungCha = document.getElementById('sua_khung_splitter_cha_sua');
        if (loai === '1:16') {
            khungCha.classList.remove('d-none');                        
        } else {
            khungCha.classList.add('d-none');
            }
    }

function capNhatGoiCuocSua() {
    const loaiHinh = document.getElementById('chon_loai_hinh_sua').value;
    const selectGoiCuoc = document.getElementById('chon_goi_cuoc_sua');
    selectGoiCuoc.innerHTML = '<option value="">-- Chọn gói cước --</option>';

    if (!loaiHinh) return;
    const danhSachLoc = mangGoiCuoc.filter(gc => gc.loai_hinh_thue_bao && gc.loai_hinh_thue_bao.includes(loaiHinh));

    danhSachLoc.forEach(gc => {
        const option = document.createElement('option');
        option.value = gc.id;
        option.textContent = gc.ten_goi_cuoc;
        selectGoiCuoc.appendChild(option);
    });
}

function kiemTraQuyen() {
    var quyen1 = sessionStorage.getItem('quyen_nguoi_dung');
    console.log("Quyền người dùng từ sessionStorage:", quyen1);
    const quyen = document.getElementById('quyen_nguoi_dung').value;
    const nutThem = document.getElementById('nut_them_khach_hang');
    const nutSua = document.querySelectorAll('.nut-sua-khach-hang');
    const nutXoa = document.querySelectorAll('.nut-xoa-khach-hang');

    if (quyen === 'admin') {
        if (nutThem) nutThem.style.display = 'block';
        nutSua.forEach(btn => btn.style.display = 'block');
        nutXoa.forEach(btn => btn.style.display = 'block');
    } else {
        if (nutThem) nutThem.style.display = 'none';
        nutSua.forEach(btn => btn.style.display = 'none');
        nutXoa.forEach(btn => btn.style.display = 'none');
    }
}

/**
 * Lấy toàn bộ thông tin chi tiết của một điểm kết nối dựa trên ID
 * @param {string} id - ID của điểm kết nối (_id từ MongoDB)
 * @returns {Object|null} - Đối tượng chứa toàn bộ thông tin đã được làm phẳng hoặc null
 */
function getThongTinChiTietDiemKetNoi(id) {
    if (!window.khachHangData) {
        console.error("Dữ liệu khách hàng chưa được tải!");
        return null;
    }

    // Tìm khách hàng trong dữ liệu đã fetch từ API /api/diem-ket-noi
    const kh = window.khachHangData.find(item => String(item._id) === String(id));

    if (!kh) {
        console.warn("Không tìm thấy điểm kết nối với ID:", id);
        return null;
    }

    // Trích xuất và tổ chức lại dữ liệu để dễ sử dụng
    return {
        id: kh._id,
        ten: kh.ten_khach_hang,
        loai: kh.loai_khach_hang,
        dia_chi: kh.dia_chi,
        vi_tri: {
            lat: kh.vi_tri?.coordinates[1], // Vĩ độ
            lng: kh.vi_tri?.coordinates[0]  // Kinh độ
        },
        // Thông tin hợp đồng
        hop_dong: {
            goi_cuoc_id: kh.thong_tin_hop_dong?.goi_cuoc_id,
            ngay_dang_ky: kh.thong_tin_hop_dong?.ngay_dang_ky,
            thoi_gian_su_dung: kh.thong_tin_hop_dong?.thoi_gian_su_dung_thang,
            ngay_het_han: kh.thong_tin_hop_dong?.ngay_het_han
        },
        // Thông tin kỹ thuật PPPoE & hạ tầng
        ky_thuat: {
            username: kh.thong_tin_pppoe?.username,
            password: kh.thong_tin_pppoe?.password,
            rack: kh.thong_tin_pppoe?.circuit_id?.rack,
            shelf: kh.thong_tin_pppoe?.circuit_id?.shelf,
            slot: kh.thong_tin_pppoe?.circuit_id?.slot,
            port: kh.thong_tin_pppoe?.circuit_id?.port,
            vpi: kh.thong_tin_pppoe?.circuit_id?.vpi,
            vci: kh.thong_tin_pppoe?.circuit_id?.vci
        },
        // Thông tin tủ cáp (đã populate trong router)
        splitter: {
            id: kh.splitter_id?._id,
            ten: kh.splitter_id?.ten_splitter,
            sys_id: kh.splitter_id?.sys_id,
            loai: kh.splitter_id?.loai_splitter,
            splitter_cha: kh.splitter_id?.splitter_cha_id?.ten_splitter // Dữ liệu từ populate sâu
        },
        // Trạng thái hệ thống
        trang_thai: {
            mau: kh.trang_thai_ket_noi?.mau_sac,
            ly_do: kh.trang_thai_ket_noi?.ly_do_su_co,
            kiem_tra_cuoi: kh.trang_thai_ket_noi?.lan_kiem_tra_cuoi
        },
        nguoi_tao: kh.nguoi_tao
    };
}

/**
 * Cập nhật vị trí hiển thị bên trong Modal Chọn vị trí
 * @param {number|string} lat - Vĩ độ
 * @param {number|string} lng - Kinh độ
 */
function capNhatToaDoModal(lat, lng) {
    const nLat = parseFloat(lat);
    const nLng = parseFloat(lng);

    // Kiểm tra tính hợp lệ của tọa độ[cite: 6]
    if (isNaN(nLat) || isNaN(nLng) || nLat === 0) {
        if (tempMarker && pickerMap) pickerMap.removeLayer(tempMarker);
        document.getElementById('display-lat').innerText = "0";
        document.getElementById('display-lng').innerText = "0";
        return;
    }

    // Cập nhật số liệu hiển thị trên các Badge trong Modal[cite: 6]
    document.getElementById('display-lat').innerText = nLat.toFixed(6);
    document.getElementById('display-lng').innerText = nLng.toFixed(6);

    // Nếu bản đồ picker đã khởi tạo, di chuyển camera và đặt Marker[cite: 6]
    if (pickerMap) {
        // Di chuyển tâm bản đồ và phóng to để quan sát rõ[cite: 6]
        pickerMap.setView([nLat, nLng], 18);
        
        // Cập nhật Marker (sử dụng hàm updateMarker bạn đã viết sẵn)[cite: 6]
        updateMarker(nLat, nLng);
        
        // Đảm bảo bản đồ không bị lỗi hiển thị các ô xám[cite: 6]
        setTimeout(() => pickerMap.invalidateSize(), 200);
    }
}
function chuanBiSuaDiemKhachHang(id) {
    // 1. Lấy dữ liệu đã được làm phẳng từ helper
    const kh = getThongTinChiTietDiemKetNoi(id);
    
    if (!kh) {
        alert("Không tìm thấy thông tin chi tiết của điểm kết nối này!");
        return;
    }

    try {
        console.log("Đang điền dữ liệu sửa đầy đủ cho:", kh.ten);
        
        // --- 1. THÔNG TIN KHÁCH HÀNG & LOẠI HÌNH ---
        document.getElementById('ten_khach_hang_sua').value = kh.ten || '';
        document.getElementById('dia_chi_sua_khach_hang_sua').value = kh.dia_chi || '';
        document.getElementById('vi_do_sua_khach_hang_sua').value = kh.vi_tri.lat || '';
        document.getElementById('kinh_do_sua_khach_hang_sua').value = kh.vi_tri.lng || '';
        
        // Cập nhật "Loại hình mạng" (loai_khach_hang trong Schema)
        const loaiHinhSelect = document.getElementById('chon_loai_hinh_sua');
        if (loaiHinhSelect) {
            loaiHinhSelect.value = kh.loai || '';
            // Kích hoạt hàm render danh sách gói cước theo loại hình vừa chọn
            if (typeof capNhatGoiCuocSua === 'function') {
                capNhatGoiCuocSua(); 
            }
        }

        // Cập nhật "Gói cước đăng ký" (Sử dụng setTimeout để đợi danh sách render xong)
        setTimeout(() => {
            const goiCuocSelect = document.getElementById('chon_goi_cuoc_sua');
            if (goiCuocSelect) {
                goiCuocSelect.value = kh.hop_dong.goi_cuoc_id || '';
            }
        }, 200);

        // Các thông tin hợp đồng khác
        document.getElementById('ngay_dang_ky_sua_khach_hang_sua').value = kh.hop_dong.ngay_dang_ky ? kh.hop_dong.ngay_dang_ky.substr(0, 10) : '';
        document.getElementById('thoi_gian_su_dung_thang_sua_khach_hang_sua').value = kh.hop_dong.thoi_gian_su_dung || '';

        // --- 2. HẠ TẦNG QUANG & TỦ CÁP ---
        // Điền "Tủ cáp" (Splitter ID)
        const splitterSelect = document.getElementById('splitter_id_sua_khach_hang_sua');
        if (splitterSelect) {
            splitterSelect.value = kh.splitter.id || '';
        }

        // Điền "Mã trạm" (Lấy từ thông tin tủ cáp đã populate)[cite: 17]
        const sysIdInput = document.getElementById('sys_id_sua_khach_hang_sua');
        if (sysIdInput) {
            sysIdInput.value = kh.splitter.sys_id || '';
        }
        
        // Thông tin PPPoE
        document.getElementById('username_sua_khach_hang_sua').value = kh.ky_thuat.username || '';
        document.getElementById('password_sua_khach_hang_sua').value = kh.ky_thuat.password || '';

        // Thông số Circuit ID
        document.getElementById('rack_sua_khach_hang_sua').value = kh.ky_thuat.rack || '';
        document.getElementById('shelf_sua_khach_hang_sua').value = kh.ky_thuat.shelf || '0';
        document.getElementById('slot_sua_khach_hang_sua').value = kh.ky_thuat.slot || '';
        document.getElementById('port_sua_khach_hang_sua').value = kh.ky_thuat.port || '';

        // Thiết lập đường dẫn gửi form[cite: 17]
        document.getElementById('formsuakhachhang').action = '/diemketnoi/sua/' + id;

    } catch (e) {
        console.error("Lỗi khi điền dữ liệu bổ sung vào form sửa:", e);
    }
}

    function kiemTraLoaiSplitterSua() {
        const loai = document.getElementById('sua_loai_splitter_sua').value;
        const khungCha = document.getElementById('sua_khung_splitter_cha_sua');
        if (loai === '1:16') {
            khungCha.classList.remove('d-none');
        } else {
            khungCha.classList.add('d-none');
        }
    }

        function kiemTraLoaiSplitterThem() {
        const loai_them = document.getElementById('sua_loai_splitter_them').value;
        const khungCha = document.getElementById('sua_khung_splitter_cha_them');
        if (loai_them === '1:16') {
            khungCha.classList.remove('d-none');
        } else {
            khungCha.classList.add('d-none');
        }
    }

    // ==========================================
    // SỰ KIỆN KHI CLICK BẢN ĐỒ DASHBOARD (THÊM NÚT)
    // ==========================================
        let mapClickPopup = null;

    function onMapClick(e) {
        if(userVaiTroId === 3) { // Nếu là vai trò "nhân viên kỹ thuật" (giả sử id = 3)
            console.log("Bạn không có quyền thêm mới điểm kết nối. Vui lòng liên hệ quản trị viên.");
            return;
        }
    const { lat, lng } = e.latlng;
        if (mapClickPopup) {
            window.appMap.closePopup(mapClickPopup);
            mapClickPopup = null;
        }
            const popupContent = `
            <div style="min-width:200px;text-align:center;padding:10px;">
                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                    <i class="bi bi-geo-alt-fill text-danger"></i> Vị trí đã chọn
                </h6>
                <div class="mb-3"><small class="text-muted"><i class="bi bi-globe2"></i> ${lat.toFixed(6)}, ${lng.toFixed(6)}</small></div>
                <div class="d-grid gap-2">
                    <button class="btn btn-sm btn-warning fw-bold text-dark shadow-sm rounded-pill"
                            onclick="themSplitterTaiViTri(${lat}, ${lng})">
                        <i class="bi bi-hdd-network-fill"></i> Thêm Tủ Cáp tại đây
                    </button>
                    <button class="btn btn-sm btn-success fw-bold text-white shadow-sm rounded-pill"
                            onclick="themKhachHangTaiViTri(${lat}, ${lng})">
                        <i class="bi bi-person-plus-fill"></i> Thêm Khách Hàng tại đây
                    </button>
                </div>
            </div>`;
        mapClickPopup = L.popup({ closeButton: true, autoClose: true, closeOnClick: true })
            .setLatLng([lat, lng])
            .setContent(popupContent)
            .openOn(window.appMap);
    }

    function themSplitterTaiViTri(lat, lng) {
        if (mapClickPopup) {
            window.appMap.closePopup(mapClickPopup);
            mapClickPopup = null;
        }
        const nut_them_dia_diem = document.getElementById('nut_chon_vi_tri_tu_pon');
        nut_them_dia_diem.hidden = true; // Ẩn nút "Chọn trên bản đồ" trong modal thêm tủ vì đã chọn vị trí từ bản đồ rồi
        // Điền tọa độ vào input của modal thêm tủ
    const inputViDo = document.getElementById('vi_do_tu_pon');
    const inputKinhDo = document.getElementById('kinh_do_tu_pon');
    if (inputViDo && inputKinhDo) {
        inputViDo.value = lat;
        inputKinhDo.value = lng;
    }
const formModalEl = document.getElementById('modalThemSplitter');
    if(!formModalEl) {
        console.error('Không tìm thấy modal để thêm tủ!');
        return;
    }
    // Mở modal thêm tủ
    let formModal = bootstrap.Modal.getInstance(formModalEl);
        if (!formModal) {
            formModal = new bootstrap.Modal(formModalEl);
        }
        formModal.show();
}

    function themKhachHangTaiViTri(lat, lng) {
        if (mapClickPopup) {
            window.appMap.closePopup(mapClickPopup);
            mapClickPopup = null;
        }
        const nut_them_dia_diem = document.getElementById('nut_chon_vi_tri_dia_diem'); 
        nut_them_dia_diem.hidden = true; // Ẩn nút "Chọn trên bản đồ" trong modal thêm khách hàng vì đã chọn vị trí từ bản đồ rồi
        // Điền tọa độ vào input của modal thêm khách hàng
    const inputViDo = document.getElementById('vi_do_them_khach_hang');
    const inputKinhDo = document.getElementById('kinh_do_them_khach_hang');
    if (inputViDo && inputKinhDo) {
        inputViDo.value = lat;
        inputKinhDo.value = lng;
    }
    const formModalEl = document.getElementById('modalThemDiemKhachHang');
    if(!formModalEl) {
        console.error('Không tìm thấy modal để thêm khách hàng!');
        return;
    }
    // Mở modal thêm khách hàng
    let formModal = bootstrap.Modal.getInstance(formModalEl);
        if (!formModal) {
            formModal = new bootstrap.Modal(formModalEl);
        }
        formModal.show();
}


//Hàm chuẩn bị cho Modal Cập nhật tiến độ
                    function chuanBiCapNhat(baoCaoId, diemId, tenKhachHang) {
                        console.log("Chuẩn bị cập nhật tiến độ cho điểm kết nối:", tenKhachHang, "(ID:", diemId + ")", "Báo cáo ID:", baoCaoId);
                        document.getElementById('bao_cao_id_cn').value = baoCaoId;
                        document.getElementById('diem_ket_noi_id_cn').value = diemId;
                        document.getElementById('ten_khach_hang_cn').innerText = tenKhachHang;
                    }
    // ==========================================
    // KHỞI TẠO CHÍNH KHI DOM SẴN SÀNG
    // ==========================================
    document.addEventListener('DOMContentLoaded', function () {
        // Áp dụng scale giao diện
        applyScale();

        // --- Khởi tạo bản đồ dashboard ---
        const mapContainer = document.getElementById('map-dashboard');
        if (window.appMap !== null) {
            window.appMap.remove();
            window.appMap = null;
        }
        if (mapContainer && mapContainer._leaflet_id) {
            mapContainer._leaflet_id = null;
        }

        try {
            window.appMap = L.map('map-dashboard').setView([10.37, 105.43], 14);
            L.tileLayer('http://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
                maxZoom: 20,
                minZoom: 6,
                noWrap: true,
                bounds: [[8.0, 102.0], [24.0, 110.0]],
                subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
                attribution: '© Google Maps'
            }).addTo(window.appMap);
            window.appMap.setMaxBounds([[5.0, 95.0], [25.0, 115.0]]);

            // Gắn sự kiện click bản đồ (thêm popup 2 nút)
            window.appMap.on('click', onMapClick);
            document.getElementById('map-dashboard').style.cursor = 'crosshair';

        } catch (e) {
            console.error("Lỗi khi tạo bản đồ:", e);
        }

        // --- Tải dữ liệu và vẽ marker ---
        Promise.all([
            fetch('/api/diem-ket-noi').then(res => res.json()),
            fetch('/api/splitters').then(res => res.json())
        ])
        .then(([khachHangData, splitterData]) => {
            window.khachHangData = khachHangData;
            const uniqueSplitters = {};
            const uniqueSplittersCap1 = {};

            // Vẽ splitters
            if (splitterData && splitterData.length > 0) {
                splitterData.forEach(sp => {
                    if (sp.vi_tri && sp.vi_tri.coordinates) {
                        const [spLng, spLat] = sp.vi_tri.coordinates;
                        const spId = String(sp._id).toLowerCase().trim();

                        const popupContent = `
                            <div style="min-width:170px;text-align:center;">
                                <h6 class="text-info fw-bold mb-2 border-bottom pb-2">
                                    <i class="bi bi-router-fill"></i> ${sp.ten_splitter}
                                </h6>
                                <span class="badge bg-light text-dark border mb-3 px-3 py-2 rounded-pill shadow-sm">
                                    TỦ CẤP ${sp.loai_splitter === '1:4' ? '1' : '2'} | ${sp.sys_id || 'N/A'}
                                </span>
                                <% if(user.vai_tro_id !== 3) { %>
                                <div class="d-grid gap-2">
                                    <a href="/splitter" class="btn btn-sm btn-outline-info text-dark fw-bold shadow-sm rounded-pill">
                                        <i class="bi bi-pencil-square"></i> Quản lý
                                    </a>
                                    <button class="btn btn-sm btn-warning fw-bold text-dark shadow-sm rounded-pill"
                                            onclick="chuanBiSuaSplitter('${sp._id}', '${sp.ten_splitter}', '${sp.sys_id}', '${sp.loai_splitter}', '${sp.splitter_cha_id || 'đây là splitter cấp 1'}', '${sp.vi_tri.coordinates[1]}', '${sp.vi_tri.coordinates[0]}')"
                                            data-bs-toggle="modal" data-bs-target="#modalSuaSplitter">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                </div>
                                <% } %>
                            </div>`;

                        if (sp.loai_splitter === '1:4') {
                            uniqueSplittersCap1[spId] = sp;
                            const iconTu1 = L.divIcon({
                                className: 'topo-node node-tucap1',
                                html: '<i class="bi bi-hdd-rack-fill fs-5" style="color:#fd7e14"></i>',
                                iconSize: [44, 44], iconAnchor: [22, 22]
                            });
                            const sp1Marker = L.marker([spLat, spLng], { icon: iconTu1 }).addTo(window.appMap);
                            sp1Marker.bindPopup(popupContent);
                            window.appSplitterMarkers[spId] = sp1Marker;
                        } else {
                            uniqueSplitters[spId] = sp;
                            const iconTu2 = L.divIcon({
                                className: 'topo-node node-tucap2',
                                html: '<i class="bi bi-router-fill" style="color:#0d6efd"></i>',
                                iconSize: [34, 34], iconAnchor: [17, 17]
                            });
                            const sp2Marker = L.marker([spLat, spLng], { icon: iconTu2 }).addTo(window.appMap);
                            sp2Marker.bindPopup(popupContent);
                            window.appSplitterMarkers[spId] = sp2Marker;

                            if (sp.splitter_cha_id) {
                                const spCha = splitterData.find(s => String(s._id) === String(sp.splitter_cha_id));
                                if (spCha && spCha.vi_tri && spCha.vi_tri.coordinates) {
                                    L.polyline([
                                        [spCha.vi_tri.coordinates[1], spCha.vi_tri.coordinates[0]],
                                        [spLat, spLng]
                                    ], {
                                        color: '#fd7e14', weight: 6, dashArray: '10, 8', opacity: 0.9, className: 'trunk-line-glow'
                                    }).addTo(window.appMap);
                                }
                            }
                        }
                    }
                });
            }

            // Vẽ khách hàng
            if (khachHangData && khachHangData.length > 0) {
                khachHangData.forEach(diem => {                                  
                    if (diem.vi_tri && diem.vi_tri.coordinates) {
                        const [lng, lat] = diem.vi_tri.coordinates;
                        const isError = diem.trang_thai_ket_noi.mau_sac === 'Đỏ';
                        const isEndDate = diem.trang_thai_ket_noi.mau_sac === 'Xám';
                        
                        let iconClass = isError ? 'node-kh-do' : (diem.trang_thai_ket_noi.mau_sac === 'Xám' ? 'node-kh-xam' : 'node-kh-xanh');
                        let iconColor = isError ? '#dc3545' : (diem.trang_thai_ket_noi.mau_sac === 'Xanh' ? '#198754' : '#6c757d');

                        const iconKH = L.divIcon({
                            className: `topo-node ${iconClass}`,
                            html: `<i class="bi bi-house-door-fill" style="color:${iconColor}"></i>`,
                            iconSize: [28, 28], iconAnchor: [14, 14]
                        });

                        const marker = L.marker([lat, lng], { icon: iconKH }).addTo(window.appMap);
                        window.appMarkers[String(diem._id).toLowerCase().trim()] = marker;

                        let popupContent = `
                            <div style="min-width:220px;">
                                <div class="d-flex align-items-center mb-2 border-bottom pb-2">
                                    <div class="bg-${isError ? 'danger' : 'success'} text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width:36px;height:36px;font-size:16px;">
                                        <i class="bi bi-house-door-fill"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 text-wrap">${diem.ten_khach_hang}</h6>
                                        <small class="text-${isError ? 'danger fw-bold' : 'success'}">${isError ? 'Đang gặp sự cố' : 'Đang hoạt động'}</small>
                                    </div>
                                </div>
                                <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill text-secondary"></i> ${diem.dia_chi}</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <% if(user.vai_tro_id !== 3) { %>
                                        <button class="btn btn-sm btn-warning fw-bold text-dark shadow-sm rounded-pill px-3"
                                                onclick="chuanBiSuaDiemKhachHang('${diem._id}')"
                                                data-bs-toggle="modal" data-bs-target="#modalSuaDiemKhachHang">                                       
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </button>
                                    <% } %>                                    
                                ${isError ? `
                                        <button class="btn btn-sm btn-primary fw-bold shadow-sm rounded-pill px-3 flex-grow-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCapNhatTienDo"
                                                onclick="chuanBiCapNhat('${diem.bao_cao_id}', '${diem._id}', '${diem.ten_khach_hang}')">
                                            <i class="bi bi-tools me-1"></i> Xử lý sự cố
                                        </button>
                                    ` : ''}
                                    
                                    ${isEndDate ? `
                                        <button class="btn btn-sm btn-success fw-bold text-white shadow-sm rounded-pill px-3 flex-grow-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalGiaHan"
                                                onclick="chuanBiGiaHan('${diem._id}', '${diem.ten_khach_hang}')">
                                            <i class="bi bi-calendar-plus me-1"></i> Gia hạn
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger fw-bold shadow-sm rounded-pill px-3 flex-grow-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalThuHoi"
                                                onclick="chuanBiThuHoi('${diem._id}', '${diem.ten_khach_hang}')">
                                            <i class="bi bi-plug me-1"></i> Thu hồi
                                        </button>
                                    ` : ''}
                                </div>
                            </div>`;
                        marker.bindPopup(popupContent);

                        if (diem.splitter_id && diem.splitter_id.vi_tri) {
                            const [sp2Lng, sp2Lat] = diem.splitter_id.vi_tri.coordinates;
                            L.polyline([[lat, lng], [sp2Lat, sp2Lng]], {
                                color: isError ? '#dc3545' : '#ada',
                                weight: isError ? 7 : 5,
                                opacity: isError ? 0.8 : 0.7,
                                dashArray: isError ? '6, 15' : '6, 6',
                                lineCap: 'round'
                            }).addTo(window.appMap);
                        }
                    }
                });
            }

            // Cập nhật dropdown danh sách tủ cáp
            const splitterListEl = document.getElementById('splitter-dropdown-list');
            const splitterCountEl = document.getElementById('splitter-count');
            const splArr1 = Object.values(uniqueSplittersCap1);
            const splArr2 = Object.values(uniqueSplitters);
            const allSplitters = [...splArr1, ...splArr2];

            if (splitterCountEl) splitterCountEl.innerText = allSplitters.length;

            if (splitterListEl) {
                splitterListEl.innerHTML = '';
                if (allSplitters.length === 0) {
                    splitterListEl.innerHTML = '<li><a class="dropdown-item disabled">Không có dữ liệu tủ</a></li>';
                } else {
                    if (splArr1.length > 0) {
                        splitterListEl.innerHTML += `<li><h6 class="dropdown-header text-warning"><i class="bi bi-hdd-rack-fill"></i> TỦ CẤP 1 (1:4)</h6></li>`;
                        splArr1.forEach(sp => {
                            splitterListEl.innerHTML += `
                                <li><a class="dropdown-item d-flex justify-content-between align-items-center" href="javascript:void(0)" onclick='zoomToMap("${sp._id}")'>
                                    <span>${sp.ten_splitter}</span>
                                    <small class="text-muted" style="font-size:0.65rem;">${sp.sys_id || ''}</small>
                                </a></li>`;
                        });
                    }
                    splitterListEl.innerHTML += `<li><hr class="dropdown-divider"></li>`;
                    if (splArr2.length > 0) {
                        splitterListEl.innerHTML += `<li><h6 class="dropdown-header text-primary"><i class="bi bi-router-fill"></i> TỦ CẤP 2 (1:16)</h6></li>`;
                        splArr2.forEach(sp => {
                            splitterListEl.innerHTML += `
                                <li><a class="dropdown-item d-flex justify-content-between align-items-center" href="javascript:void(0)" onclick='zoomToMap("${sp._id}")'>
                                    <span>${sp.ten_splitter}</span>
                                    <small class="text-muted" style="font-size:0.65rem;">${sp.sys_id || ''}</small>
                                </a></li>`;
                        });
                    }
                }
            }
        })
        .catch(err => console.error("Lỗi tải API Bản đồ:", err));

        // --- Sự kiện modal chọn vị trí ---
        const modalPickEl = document.getElementById('modalPickLocation');
        if (modalPickEl) {
            modalPickEl.addEventListener('shown.bs.modal', function () {
                if (!pickerMap) {
                    try {
                        pickerMap = L.map('map-picker').setView([10.37, 105.43], 15);
                        L.tileLayer('http://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
                            maxZoom: 20,
                            minZoom: 6,
                            noWrap: true,
                            bounds: [[8.0, 102.0], [24.0, 110.0]],
                            subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
                            attribution: '© Google Maps'
                        }).addTo(pickerMap);
                        pickerMap.on('click', function(e) {
                            updateMarker(e.latlng.lat, e.latlng.lng);
                        });
                    } catch (err) {
                        console.error("Lỗi khởi tạo bản đồ picker:", err);
                    }
                } else {
                    pickerMap.invalidateSize();
                }
                setTimeout(() => {
                    if (pickerMap) pickerMap.invalidateSize();
                }, 100);
            });
        }
    });

 //Hàm chuẩn bị cho Modal Lập báo cáo
                    function chuanBiLapBaoCao(id, tenKhachHang) {
                        document.getElementById('diem_ket_noi_id').value = id;
                        document.getElementById('ten_khach_hang_bc').innerText = tenKhachHang;
                    }

                     //Hàm chuẩn bị cho Modal Gia hạn hợp đồng
                    function chuanBiGiaHan(id, ten, hanCu) {
                        console.log("Chuẩn bị gia hạn hợp đồng cho:", ten, "(ID:", id + ")", "Hạn cũ:", hanCu);
                        // document.getElementById('diem_ket_noi_id').value = id;
                        document.getElementById('diem_id_giahan').value = id;
                        document.getElementById('ten_khach_hang_gh').innerText = ten;
                        document.getElementById('ngay_het_han_cu').innerText = hanCu;
                    }

                    //Hàm chuẩn bị cho Modal Thu hồi thiết bị
                    function chuanBiThuHoi(id, ten) {
                        console.log("Chuẩn bị thu hồi thiết bị cho:", ten, "(ID:", id + ")");
                        document.getElementById('diem_id_thuhoi').value = id;
                        document.getElementById('ten_khach_hang_th').innerText = ten;
                    }

    /**
 * Hàm xóa sạch toàn bộ dữ liệu Khách hàng và Tủ cáp
 */
function xoaTatCaDuLieu() {
    // Lớp bảo vệ 1
    if (confirm("⚠️ CẢNH BÁO NGUY HIỂM: Bạn có chắc chắn muốn xóa TOÀN BỘ dữ liệu Khách hàng và Tủ cáp khỏi bản đồ không?")) {
        
        // Lớp bảo vệ 2
        if (confirm("Hành động này KHÔNG THỂ HOÀN TÁC. Bạn sẽ mất sạch dữ liệu. Nhấn OK để xác nhận xóa!")) {
            
            fetch('/xoa-tat-ca-du-lieu', {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    // Xóa xong thì tải lại trang để bản đồ và bảng dữ liệu trống trơn
                    window.location.reload(); 
                } else {
                    alert("Lỗi: " + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Lỗi mạng hoặc server không phản hồi!');
            });
        }
    }
}
</script>
    <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>